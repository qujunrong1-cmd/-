  "mechanics": [
    {
      "term": "特工",
      "means": "Agent，可选角色，国服官方称「特工」，旧译「契约者/英雄」"
    },
    {
      "term": "决斗 / 先锋 / 控场 / 哨卫",
      "means": "四大定位，不要写成「决斗者/守护者/控场者」"
    },
    {
      "term": "爆能器",
      "means": "Spike。安装/拆除爆能器，口语叫「下包/拆包」"
    },
    {
      "term": "购买阶段",
      "means": "Buy Phase，每回合开局 30 秒"
    },
    {
      "term": "标志性技能",
      "means": "Signature Ability，每回合免费刷新"
    },
    {
      "term": "终极技能",
      "means": "Ultimate，靠终极点数充能"
    },
    {
      "term": "轻甲 / 重甲 / 再生护甲",
      "means": "25 盾 / 50 盾 / 25 盾可回复"
    },
    {
      "term": "急停",
      "means": "Counter-strafe，反向按键瞬间停住再开枪"
    },
    {
      "term": "预瞄",
      "means": "Pre-aim，提前把准星放在敌人头部会出现的位置"
    },
    {
      "term": "头线",
      "means": "地图上人形头部所在的水平高度"
    },
    {
      "term": "补枪",
      "means": "Trade，队友倒下后立刻换掉对方"
    },
    {
      "term": "首杀",
      "means": "First Blood，本回合第一个击杀"
    },
    {
      "term": "白给",
      "means": "口语，指该回合没有击杀/助攻/存活/被换，纯亏"
    },
    {
      "term": "eDPI",
      "means": "DPI × 游戏内灵敏度；cm/360 = 13063 ÷ eDPI"
    }
  ],
